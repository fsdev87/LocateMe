<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/item_card_background"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <!-- Item Image -->
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/item_placeholder"
        android:scaleType="centerCrop"
        android:background="@drawable/item_image_background"
        android:contentDescription="Item Image"/>

    <!-- Item Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <!-- Badge -->
        <TextView
            android:id="@+id/item_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FOUND"
            android:textColor="@color/white"
            android:background="@drawable/found_badge"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Item Title -->
        <TextView
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dark Chocolate Cake"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <!-- Item Description -->
        <TextView
            android:id="@+id/item_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Found a chocolate cake in the library. Contact me asap."
            android:textColor="@color/text_color"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"/>

        <!-- Location, Time, and Person in one row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Location"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/item_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library - 3rd floor"
                android:textColor="@color/text_color"
                android:textSize="11sp"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_time"
                android:contentDescription="Time"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/item_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 hour ago"
                android:textColor="@color/text_color"
                android:textSize="11sp"
                android:layout_marginEnd="16dp"/>

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_person"
                android:contentDescription="Person"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/item_person"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abigail"
                android:textColor="@color/text_color"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
